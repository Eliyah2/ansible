server {
    listen 80;
    listen [::]:80;

    server_name {{ web_domain }} {{ web_server_name }};

    root {{ web_root }};
    index index.php index.html;

    access_log /var/log/nginx/eliyah-web.access.log;
    error_log  /var/log/nginx/eliyah-web.error.log;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
    }

    location ~ /\. {
        deny all;
    }
}
